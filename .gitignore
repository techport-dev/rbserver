# Xcode build caches (regenerated by scripts/build_wda.sh on every run) --
# everything under build/ EXCEPT the actual shippable app in Build/Products/
# is intermediate/compiler cache and is not worth tracking.
build/wda/Index.noindex/
build/wda/ModuleCache.noindex/
build/wda/SDKStatCaches.noindex/
build/wda/CompilationCache.noindex/
build/wda/Logs/
build/wda/Build/Intermediates.noindex/
build/wda/info.plist
build/wda/stub.c
# header files aren't needed to run the app, only to compile against it
build/wda/Build/Products/**/Headers/

# scripts/build_deb.sh output -- regenerated on demand, shipped via GitHub Releases instead
build/deb/
build/*.deb

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS cruft
.DS_Store

# Claude Code's own local session state, not project content
.claude/
